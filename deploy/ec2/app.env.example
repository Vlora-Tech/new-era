# /etc/new-era/app.env — runtime configuration for the EC2 deployment.
#
#   sudo install -m 600 -o root -g root this-file /etc/new-era/app.env
#
# Read two ways, and the format has to satisfy both:
#   - systemd's EnvironmentFile= (the service)
#   - `set -a; . file` and grep (release.sh)
#
# systemd's parser is NOT dotenv. No `export` prefixes, no ${VAR} expansion, no
# inline comments after a value, and quotes are consumed rather than kept. Plain
# KEY=value, one per line. A password containing `#` or a space will bite here.

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# MUST match the origin the browser actually uses, exactly — scheme, host and
# port. Every cookie-authenticated mutation compares the request's Origin header
# against this, so a mismatch does not degrade gracefully: logins and every form
# in the product fail with an origin error while the pages still render.
#
# Behind Caddy on a domain this is https://example.com. Straight to the app for
# a first smoke test it is http://<elastic-ip>:3000.
NEXT_PUBLIC_APP_URL=http://REPLACE_ME:3000

PORT=3000
# 127.0.0.1 once a reverse proxy is in front. 0.0.0.0 exposes the app directly,
# which is only reasonable for a first smoke test with the port open in the
# security group.
HOSTNAME=127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────
# The runtime role: rows only, no DDL. See infra/sql/02-create-roles.sql.
#
# `connection_limit` bounds the Prisma pool. db.t4g.micro is small; keep this
# small too.
#
# On sslmode: RDS has rds.force_ssl=1, so an unencrypted connection is refused
# outright. Prisma's connector is NOT libpq — it accepts `disable`, `prefer` and
# `require`, and `verify-full` is a libpq value that infra/terraform/parameters.tf
# emits but Prisma may not honour. Start with `require`, confirm the connection,
# then tighten with `sslcert=` pointing at the RDS CA bundle if you want the
# server's identity verified rather than merely the channel encrypted.
DATABASE_URL=postgresql://newera_app:REPLACE_ME@REPLACE_ME.rds.amazonaws.com:5432/newera?sslmode=require&connection_limit=5

# The DDL role, used ONLY by release.sh for `prisma migrate deploy`. Kept
# separate so the running application cannot alter the schema even if it is
# compromised. The application never reads this name.
MIGRATE_DATABASE_URL=postgresql://newera_migrate:REPLACE_ME@REPLACE_ME.rds.amazonaws.com:5432/newera?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────
# At least 32 characters: openssl rand -base64 48
# Rotating this signs every session out at once.
SESSION_SECRET=REPLACE_ME
SESSION_TTL_SECONDS=604800

# ── Payments ──────────────────────────────────────────────────────────────
# No Moyasar account yet. `mock` alone would refuse to start in production; the
# flag lifts that one gate and nothing else. Purchasing stays closed —
# isCommerceEnabled() is false, order creation answers with the Arabic
# "commerce unavailable" message, and the mock completion route still 404s.
# Grant access by hand from the admin entitlements screen meanwhile.
#
# DELETE BOTH LINES the moment real keys exist.
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=true

# ── Media storage ─────────────────────────────────────────────────────────
# `local` is refused in production — the disk is not durable and uploads would
# be silently lost. No access key: the SDK's default provider chain resolves to
# the instance role.
STORAGE_PROVIDER=s3
S3_BUCKET=REPLACE_ME
S3_REGION=us-east-1
# Optional CDN origin. Left blank, public objects stream through the app's own
# route instead, so S3 works before CloudFront exists.
S3_PUBLIC_BASE_URL=

# ── Background jobs ───────────────────────────────────────────────────────
# Required in production. Nothing reads it yet — docs/deployment.md § Known gaps
# is explicit that there is no /api/internal/jobs/* route. Generated so the
# application starts.
INTERNAL_JOBS_SECRET=REPLACE_ME
