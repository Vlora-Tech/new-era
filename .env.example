# بناء العهد الجديد — environment variable names and safe local placeholders.
# Copy to `.env` and fill in. Never commit a real `.env`.
# No production secret belongs in this file.

# ── App ──────────────────────────────────────────────────────────────────
# Must match the port the server actually serves on: the same-origin check on
# every cookie-authenticated mutation compares the browser's Origin against it.
# `npm run dev` pins 3005 because Docker Desktop commonly holds 3000.
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ── Database (matches docker-compose.yml; host port 5544) ────────────────
DATABASE_URL=postgresql://newera:newera_local_dev@localhost:5544/new_era_dev
TEST_DATABASE_URL=postgresql://newera:newera_local_dev@localhost:5544/new_era_test

# ── Auth ─────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
SESSION_TTL_SECONDS=604800

# ── Development seed admin (development only) ────────────────────────────
# Production admins are created by `npm run admin:bootstrap`, never by the seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-only
ADMIN_NAME=مدير المنصة

# ── Payments (Moyasar) ───────────────────────────────────────────────────
# `mock` is development-only and is rejected at startup when NODE_ENV=production.
PAYMENT_PROVIDER=mock
MOYASAR_API_BASE_URL=https://api.moyasar.com
MOYASAR_MODE=test
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET_TOKEN=

# ── Bunny Stream ─────────────────────────────────────────────────────────
# Three distinct credentials with distinct purposes; none may be exposed.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_SECURITY_KEY=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READONLY_API_KEY=
PLAYBACK_TOKEN_TTL_SECONDS=2700

# ── Media storage ────────────────────────────────────────────────────────
# `local` is rejected at startup when NODE_ENV=production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.storage

# Required when STORAGE_PROVIDER=s3 (refused at startup without them).
# There is deliberately no access key here: the client uses the default AWS
# provider chain, which resolves to the container's IAM role. If you find
# yourself wanting to paste a long-lived key into this file, fix the role.
S3_BUCKET=
S3_REGION=
# Optional CDN origin in front of the bucket, e.g. https://cdn.example.com
# Leave blank and public objects stream through the app's own route instead,
# so S3 works before CloudFront exists.
S3_PUBLIC_BASE_URL=

# ── Background jobs ──────────────────────────────────────────────────────
# Bearer token for /api/internal/jobs/*. Must be at least 32 characters.
INTERNAL_JOBS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ENABLE_EMBEDDED_SCHEDULER=true
